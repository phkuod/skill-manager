# Reference of all supported environment variables.
#
# In practice, copy .env.development.example -> .env.development or
# .env.production.example -> .env.production. start.sh sources the file
# matching the mode you run (`./start.sh` -> .env.development,
# `./start.sh prod` -> .env.production).

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-strong-random-secret

DEBUG=False

# Comma-separated hostnames the server will respond to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Port the dev server / gunicorn binds to.
PORT=3000

# Origin(s) allowed to call /api/* from a browser. Default '*' opens the API
# to any origin (suitable for unauthenticated internal tools). Browsers do
# not support a comma-separated list.
CORS_ALLOWED_ORIGINS=*

# Path to the skill repository (defaults to <repo>/skill_repo if unset).
SKILL_REPO_PATH=./skill_repo

# ---------------------------------------------------------------------------
# Install targets (one-click install feature)
# ---------------------------------------------------------------------------
# Each install target is a group of INSTALL_TARGET_<NAME>_* keys. <NAME>
# appears verbatim in the UI ("Install to F12"). Allowed: A-Z, 0-9.
#
# Required fields:
#   _TYPE     'local' (filesystem on this host) or 'ssh' (rsync over SSH)
#   _BASE     Target dir; SHOULD include the {user_name} placeholder.
#             WARNING: if _BASE has no {user_name}, every user will install
#             to the same directory and overwrite each other's work. Always
#             include {user_name} unless you have a specific reason not to.
#
# ssh-only fields:
#   _HOST     Remote host (DNS or IP)
#   _USER     SSH login user
#   _SSH_KEY  Absolute path to private key file (passwordless, BatchMode)
#
# Hard timeout for any single install (local copy or rsync). Default 60s.
# INSTALL_TIMEOUT_SECONDS=60

# Example layout (uncomment and edit per environment):
# INSTALL_TARGET_F12_TYPE=local
# INSTALL_TARGET_F12_BASE=/AAA/{user_name}/skills
#
# INSTALL_TARGET_F15_TYPE=ssh
# INSTALL_TARGET_F15_BASE=/AAA/{user_name}/skills
# INSTALL_TARGET_F15_HOST=f15.intra.example
# INSTALL_TARGET_F15_USER=svc-skillmarket
# INSTALL_TARGET_F15_SSH_KEY=/etc/ssh/skillmarket_id_rsa

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_FILE: path to the rotating log file. Default: logs/skill-market.log
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. Default: INFO
# LOG_MAX_BYTES: max bytes per log file before rotation. Default: 10485760 (10 MB)
# LOG_BACKUP_COUNT: number of rotated files to keep. Default: 5
# LOG_FILE=logs/skill-market.log
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# AI reviewer (phase 2)
# ---------------------------------------------------------------------------
# Dark switch — feature ships off. Flip to true only after LLM_API_KEY (or
# OPENROUTER_API_KEY) is set, the operator has confirmed the model chain is
# reachable, and ops has read docs/SKILL_POLICY.md.
# AI_REVIEW_ENABLED=false
#
# LLM endpoint. Default targets OpenRouter; swap to your internal
# OpenAI-compatible gateway in prod (e.g. https://llm.internal.corp/v1) along
# with the model chain below.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=         # falls back to OPENROUTER_API_KEY if blank
# OPENROUTER_API_KEY=
#
# Comma-separated "k=v" pairs forwarded as default request headers. The
# default sends HTTP-Referer + X-Title because OpenRouter wants them for
# request attribution. Internal gateway will ignore.
# LLM_EXTRA_HEADERS=HTTP-Referer=https://skills.local,X-Title=Skill Market AI reviewer
#
# Model fallback chain (first is primary). Comma-separated. Default targets
# strong free models on OpenRouter; in prod use your internal model names.
# AI_REVIEW_MODELS=deepseek/deepseek-r1:free,qwen/qwen-2.5-72b-instruct:free,meta-llama/llama-3.3-70b-instruct:free
#
# Tunables (defaults shown):
# AI_REVIEW_MAX_INPUT_TOKENS=12000           # truncates prompt above this
# AI_REVIEW_TIMEOUT_S=120                    # per-call wall-clock
# AI_REVIEW_RATE_BUDGET_PER_MIN=15           # 0 disables; per model
# AI_REVIEW_CONCURRENT_WORKERS=1             # bump on internal gateways
# AI_REVIEW_AUTO_NUDGE=always                # 'always' | 'if_findings' | 'off'
# AI_REVIEW_CONFIDENCE_CAP=0.8               # 1.0 to disable cap
# AI_REVIEW_DROP_HALLUCINATED_EVIDENCE=true  # false on strong models
# AI_REVIEW_RERUN_DAILY_CAP_PER_SUBMISSION=3 # admin re-run quota
# AI_REVIEW_CATALOG_DETAIL=hashes            # 'hashes' on external, 'full' on internal
#
# One-line footer appended to every AI comment when set. Clear (empty string)
# once running on a private internal endpoint.
# AI_REVIEW_PRIVACY_NOTICE=Reviewed by an external LLM; bundle content may be retained per the provider's policy.
